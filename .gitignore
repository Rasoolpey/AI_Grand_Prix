# ============================================================
# AI Grand Prix Workshop — .gitignore
# ============================================================

# MATLAB auto-save / backup files
*.asv
*.m~

# MATLAB compiled outputs
*.mex*
*.mexa64
*.mexmaci64
*.mexw64

# Simulink generated code
slprj/
codegen/

# MATLAB figure exports (keep source, not output dumps)
*.fig

# Practice track is committed (regenerated automatically, but saves startup time)
# Mystery track is INSTRUCTOR ONLY — never commit it to the public repo
tracks/mysteryTrack.mat

# Generated .mat files in root (if any)
*.mat
!tracks/practiceTrack.mat

# Submission folders — collected by instructor separately, not in main repo
submissions/*/

# Python virtual environments (for MCP server)
.venv/
__pycache__/
*.pyc
*.pyo

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE files
.vscode/settings.json
.idea/
*.swp
*.swo

# Log and temporary files
*.log
*.tmp

# Environment / credentials — NEVER commit these
.env

# Instructor reference PDFs / docs (not for student repo)
Documents/
